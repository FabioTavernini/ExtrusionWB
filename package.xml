<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">

    <name>TSlotWorkbench</name>
    <description>Parametric metric T-slot aluminium extrusions (Generic and Bosch Rexroth compatible B-Type, 2020 to 8080), corner brackets that snap into 90 degree joints, and T-nuts with screws from the Fasteners workbench.</description>
    <version>0.2.0</version>
    <date>2026-10-18</date>

    <maintainer email="baeurlelara@outlook.com">TSlotWorkbench maintainer</maintainer>
    <license file="LICENSE">LGPL-2.1-or-later</license>

    <icon>Resources/Icons/Logo.svg</icon>

    <freecadmin>1.1.0</freecadmin>

    <!-- Screws come from the Fasteners workbench; without it, everything but screws still works. -->
    <depend type="addon">fasteners</depend>

    <tag>extrusion</tag>
    <tag>aluminium profile</tag>
    <tag>t-slot</tag>

    <content>
        <workbench>
            <classname>TSlotWorkbench</classname>
        </workbench>
    </content>

</package>
